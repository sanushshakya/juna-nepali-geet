{
  "name": "juna-nepali-geet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Old Nepali Songs: press play, classic songs keep playing.",
  "scripts": {
    "build": "node build.mjs",
    "serve": "node build.mjs && python3 -m http.server 8090 -d dist",
